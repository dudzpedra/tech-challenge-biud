{
  "name": "tech-challenge-biud",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "quality": "pnpm run quality-gate",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "pnpm --recursive run lint",
    "quality-gate": "pnpm run format:check && pnpm --recursive run lint && pnpm --recursive run typecheck && pnpm --recursive run test && pnpm --recursive run build",
    "prepare": "husky",
    "postinstall": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:seed": "tsx --env-file=.env prisma/seed.ts",
    "build:backends": "pnpm --filter @biud/transactions-api build && pnpm --filter @biud/anti-fraud-ms build"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^10.0.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.5.3",
    "prisma": "^7.9.1",
    "tsx": "^4.23.5",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
